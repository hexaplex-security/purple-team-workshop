{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workshop-gate",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "workshop.hexaplex.ch", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    // Hugo build output. Must match the site skeleton's publishDir.
    "directory": "../site/public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Default-deny: everything goes through the gate except theme CSS/JS/fonts.
    // Relearn writes the full-text search index (searchindex.*.js) at the site root,
    // not under /js/, so it stays gated.
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/fonts/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workshop-audit",
      // Replace with the id printed by `npx wrangler d1 create workshop-audit`.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "observability": { "enabled": true }
  // Secret, set with `npx wrangler secret put TOKEN_KEY` (never committed).
}
